{
  "name": "dsh-a2ui",
  "version": "0.3.0",
  "description": "Generative UI for DeepSeek Harness: renders Google A2UI 1.0 surfaces inside the conversation with an agent -> UI -> agent interaction loop.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "a2ui",
    "generative-ui",
    "agent-ui"
  ],
  "license": "MIT",
  "author": "ChimeSky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChimeSky/dsh-a2ui.git"
  },
  "homepage": "https://github.com/ChimeSky/dsh-a2ui#readme",
  "bugs": {
    "url": "https://github.com/ChimeSky/dsh-a2ui/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/TEST-REPORT.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tools/run-tests.mjs",
    "verify": "node tools/verify-bundle.mjs",
    "render": "node tools/render-check.mjs",
    "inspect:session": "node tools/inspect-session-log.mjs",
    "pack:vendor": "node tools/build-vendor.mjs",
    "all": "npm run typecheck && npm run build && npm test && npm run verify && npm run render && npm run verify:fresh-home",
    "verify:fresh-home": "node tools/verify-fresh-home.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2"
  }
}
